# ═══════════════════════════════════════════════════════════════════════
#  Nexum Core — пример настроек окружения
#
#  Скопируйте этот файл и заполните значения:
#      cp .env.example .env
#      php artisan key:generate
#
#  Дальше откройте сайт в браузере — мастер установки на /install пройдёт
#  остальное сам: проверит требования, создаст таблицы, заведёт администратора
#  и наполнит сайт содержимым.
# ═══════════════════════════════════════════════════════════════════════

APP_NAME="Nexum Core"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_VERSION=1.0.0

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU
APP_TIMEZONE=Europe/Moscow

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Кнопка «Я разработчик» на шаге лицензии. Показывается, только если ключ
# реально прописан в этом файле. Для боевого сайта — уберите строку.
# DEVELOPER_MODE=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── База данных ────────────────────────────────────────────────────────
#
# 🔴 ТОЛЬКО PostgreSQL. Это осознанный выбор проекта: в мастере установки
#    других драйверов нет, а миграции и запросы рассчитаны на него.
#    Конфигурации MySQL/SQLite в config/database.php остались, но не
#    поддерживаются — не тратьте на них время.
#
# Роль и базу нужно создать ДО установки. Готовый скрипт и разбор частых
# заминок — в scripts/README-база.md.
#
#     CREATE ROLE nexum_core WITH LOGIN CREATEDB PASSWORD 'свой_пароль';
#     CREATE DATABASE nexum_core WITH OWNER = nexum_core ENCODING = 'UTF8';
#
# ⚠️ С PostgreSQL 15 после создания базы обязателен ещё один шаг, иначе
#    миграции упадут с «permission denied for schema public»:
#     \connect nexum_core
#     GRANT ALL ON SCHEMA public TO nexum_core;
#     ALTER SCHEMA public OWNER TO nexum_core;
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nexum_core
DB_USERNAME=nexum_core
DB_PASSWORD=

# ── Сессии, кеш, очередь ───────────────────────────────────────────────
#
# ⚠️ На время установки драйвер сессии обязан быть `file`: базы данных на
#    первых шагах мастера ещё нет.
#
# ⚠️ Драйвер кеша `file` НЕ поддерживает теги. Код проекта это учитывает,
#    но если переключаете на redis — проверьте, что теги действительно
#    доступны, а не появились «на словах».
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ── Почта ──────────────────────────────────────────────────────────────
#
# Шаг SMTP в мастере необязательный: без почты CMS ставится и работает,
# теряется только восстановление пароля по e-mail.
#
# ⚠️ MAIL_TIMEOUT несущий. По умолчанию транспорт ждёт ответа бесконечно, и
#    недоступный SMTP роняет запрос по лимиту времени PHP — смена статуса
#    заказа падала именно так. Пять секунд: здоровый сервер отвечает быстрее.
#
# ⚠️ Порт 465 у многих провайдеров закрыт. Если письма не уходят — пробуйте
#    587 со схемой smtp и шифрованием tls (STARTTLS), а не 465/smtps/ssl.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=5
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Автономный режим ───────────────────────────────────────────────────
#
# Один рубильник: наружу не уходит НИЧЕГО, даже если ключи интеграций
# прописаны. Заслон стоит на самом HTTP-клиенте, поэтому действует и на код,
# который напишут позже. Свои адреса (localhost, частные сети, домен из
# APP_URL) остаются доступны.
# APP_STANDALONE=true

# Сервер обновлений. Пусто — запроса нет вовсе: свой адрес задаёте сами.
# UPDATE_SERVER_URL=

# Адрес, куда шлются оповещения об ошибках (POST с JSON). Пусто — молчит.
# ALERTS_WEBHOOK=

# ── Магазин ────────────────────────────────────────────────────────────
#
# Через сколько минут отменять неоплаченный заказ и возвращать товар в
# продажу. Ноль выключает совсем.
#
# ⚠️ Требует настроенного cron (`schedule:run` раз в минуту). Без него
#    команда не выполнится никогда, и товар держится за брошенным заказом.
ORDER_UNPAID_TIMEOUT=10

# ── Каптча ─────────────────────────────────────────────────────────────
CAPTCHA_ENABLED=true

# ── Локализация ────────────────────────────────────────────────────────
LOCALIZATION_DEFAULT_COUNTRY=RU

# ── SEO ────────────────────────────────────────────────────────────────
#
# Выгрузки наружу (IndexNow, Вебмастер, Метрика) по умолчанию выключены и
# без ключей. Включать по одному, когда договор со службой уже есть.
SEO_BASE_URL=
SEO_FORCE_CURRENT_HOST=false
SEO_INDEXNOW_ENABLED=false
SEO_WEBMASTER_ENABLED=false
SEO_METRICA_ENABLED=false
SEO_YC_ENABLED=false
SEO_NEWS_SITEMAP_ENABLED=true
SEO_IMAGES_SITEMAP_ENABLED=true

# ── Прочее ─────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

VITE_APP_NAME="${APP_NAME}"
